{
  "name": "server",
  "version": "1.0.0",
  "main": "app.js",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "redis:start": "node scripts/local-redis.mjs start",
    "redis:stop": "node scripts/local-redis.mjs stop",
    "redis:status": "node scripts/local-redis.mjs status",
    "predev": "node scripts/local-redis.mjs ensure",
    "test:passwords": "node --test tests/password-hashing.test.js tests/password-timing.test.js tests/password-reset.test.js tests/profile-change.test.js tests/google-auth.test.js tests/passkeys.test.js tests/subscription-checkout.test.js tests/form-validation.test.js",
    "test:passwords:timing": "node --test tests/password-timing.test.js",
    "benchmark:passwords": "node scripts/benchmark-password-timing.js",
    "test:passwords:dev-db": "APP_ENV=dev NODE_ENV=test BGSNL_PASSWORD_TEST_DB=bgsnl_flow_test_passwords node --test tests/password-flows.dev-db.test.js",
    "test:passkeys": "node --test tests/passkeys.test.js tests/subscription-auth-and-migration.test.js",
    "lint": "eslint .",
    "start": "node app.js",
    "dev": "APP_ENV=dev PORT=8080 nodemon --exec \"node --env-file=.env.dev\" app.js",
    "start-server": "node app.js",
    "repair-join-dates": "node scripts/repair-join-dates-from-subscriptions.js",
    "backfill-marketing-emails": "node scripts/backfill-marketing-emails.js",
    "backfill-marketing-emails:archive": "node scripts/backfill-marketing-emails-from-archive.js",
    "rename-marketing-emails-collection": "node scripts/rename-marketing-emails-collection.js",
    "backfill-marketing-unsubscribed": "node scripts/backfill-marketing-email-unsubscribed.js",
    "test:domakin-mailer": "node --test tests/domakin-mailer.test.js tests/email-provider.test.js",
    "test:support": "node --test tests/support-*.test.js",
    "test:account-flows": "node --test tests/account-flow-fixtures.test.js",
    "test:event-drafts": "node --test tests/event-drafts.test.js",
    "test:subscriptions": "node --test tests/subscription-*.test.js",
    "test:weekly-membership-report": "node --test tests/weekly-membership-report.test.js",
    "test:birthday-emails": "node --test tests/birthday-emails.test.js",
    "seed:account-flows": "node scripts/seed-account-flow-fixtures.js --apply",
    "backfill:event-slugs": "node scripts/backfill-event-slugs.js",
    "send-final-reminder": "node scripts/send-non-society-final-reminder.js",
    "deploy": "git add . && git commit -m done && git push heroku main",
    "pretest:redis": "node scripts/local-redis.mjs start",
    "test:redis": "BGSNL_STORAGE_TEST_REDIS=true BGSNL_REDIS_URL=redis://127.0.0.1:6380/15 node --test tests/redis-storage.integration.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
