    "@aws-sdk/client-s3": "^3.290.0",
    "@axiomhq/js": "^1.3.1",
    "@simplewebauthn/server": "14.0.1",
    "@stripe/stripe-js": "^1.52.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^6.15.0",
    "googleapis": "^171.4.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "mailtrap": "^3.1.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "mongodb": "^4.12.1",
    "mongoose": "^6.7.5",
    "mongoose-unique-validator": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^2.10.0",
    "multer-sharp-s3": "^0.2.5",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.5",
    "pm2": "^5.4.2",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "resend": "1.0.0",
    "sharp": "^0.30.7",
    "stripe": "^11.17.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "nodemon": "^3.1.10"
  },
